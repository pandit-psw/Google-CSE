# Server Configuration
PORT=3000
NODE_ENV=development

# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# Allowed Google Workspace Domain
ALLOWED_WORKSPACE_DOMAIN=yourdomain.com

# Key Encryption Key (KEK) Configuration
# In production, this should be stored in a secure key management system
MASTER_KEK_BASE64=generate-with-node-crypto-randomBytes-32

# Database
DATABASE_PATH=./data/keys.db

# Audit Logging
ENABLE_AUDIT_LOG=true
AUDIT_LOG_PATH=./logs/audit.log
